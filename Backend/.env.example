# Database Connection String (MongoDB Atlas URI)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database_name>?retryWrites=true&w=majority

# Google Gemini API Key (Get from https://aistudio.google.com/)
GOOGLE_GENAI_API_KEY=your_google_genai_api_key_here

# JWT Secret Key for signing authentication tokens
JWT_SECRET=your_jwt_secret_key_here

# Environment ('production' or 'development')
NODE_ENV=production

# Frontend URL (e.g. https://your-project.vercel.app for CORS)
FRONTEND_URL=https://your-project.vercel.app

# Cookie SameSite setting ('lax' for same-domain or 'none' for cross-domain)
COOKIE_SAME_SITE=none

# Port for local development / long-running server (defaults to 3000)
PORT=3000
